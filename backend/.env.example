# Copy to backend/.env for local development (python-dotenv loads it).

# Signs login tokens. Without it a random key is used and sign-ins reset on restart.
SECRET_KEY=

# Defaults to a SQLite file (baseball.db) in the project root.
# DATABASE_URL=postgresql://user:password@localhost:5432/baseball_db

# CORS_ORIGINS=http://localhost:3000
# ALLOW_REGISTRATION=true
# SEED_SAMPLE_DATA=true
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# MAX_UPLOAD_MB=10
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
