# Copy to .env (next to docker-compose.yml) and fill in.

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where the browser reaches the API (baked into the frontend at build time).
PUBLIC_API_URL=http://localhost:8000

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# After the first (admin) account exists, set to false to stop new sign-ups.
# Admins can still add people from the Users page.
ALLOW_REGISTRATION=true

# Wrong passwords allowed per account (from one IP) before a lockout, and its length.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Behind a reverse proxy, set this to the proxy's IP address so sign-in limits
# see each visitor's own IP instead of the proxy's.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Optional: use PostgreSQL instead of the built-in SQLite file.
# DATABASE_URL=postgresql://user:password@db-host:5432/baseball_db
