# Copy to .env (next to docker-compose.yml) and fill in.

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where the browser reaches the API (baked into the frontend at build time).
PUBLIC_API_URL=http://localhost:8000

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# After the first (admin) account exists, set to false to stop new sign-ups.
ALLOW_REGISTRATION=true

# Optional: use PostgreSQL instead of the built-in SQLite file.
# DATABASE_URL=postgresql://user:password@db-host:5432/baseball_db
